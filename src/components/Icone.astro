---
import { ICONES, type IconeNome } from "../data/brand";
interface Props { nome: IconeNome; class?: string; }
const { nome, class: cls = "" } = Astro.props;
---
<svg class={`icone ${cls}`} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path d={ICONES[nome]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
</svg>
