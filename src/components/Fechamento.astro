---
/**
 * Fechamento de página no registro "Faixa diagonal" (tela): fundo noite + faixas a 48° em degradê Aurora.
 * Uma faixa larga e no máximo uma estreita. Texto na área calma, à esquerda.
 */
import Seta from "./Seta.astro";
import { FAIXA, FAIXA_ESTREITA } from "../data/brand";
interface Props { rotulo?: string; titulo: string; texto?: string; cta?: string; href?: string; }
const { rotulo = "Próximo passo", titulo, texto, cta = "Agendar conversa", href = "/contato" } = Astro.props;
---
<section class="fech bg-noite on-dark" aria-labelledby="fech-t">
  <svg class="fech__faixas" viewBox="0 0 900 560" aria-hidden="true" preserveAspectRatio="xMaxYMid slice">
    <defs>
      <linearGradient id="aurora" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#7546F6" />
        <stop offset=".52" stop-color="#22C6E8" />
        <stop offset="1" stop-color="#71E3BA" />
      </linearGradient>
    </defs>
    <path d={FAIXA.d} fill="url(#aurora)" transform="translate(300 40) scale(1.08)" />
    <path d={FAIXA_ESTREITA.d} fill="#71E3BA" opacity=".9" transform="translate(560 90) scale(.9)" />
  </svg>
  <div class="wrap fech__in">
    <div class="cabeca">
      <p class="rotulo">{rotulo}</p>
      <h2 id="fech-t">{titulo}</h2>
      {texto && <p class="lead">{texto}</p>}
    </div>
    <div class="acoes" style="margin-top:32px">
      <a class="btn" href={href}>{cta} <Seta /></a>
    </div>
  </div>
</section>

<style>
  .fech { position: relative; overflow: hidden; padding-block: clamp(80px, 10vw, 136px); }
  .fech__faixas { position: absolute; right: -6%; top: 0; height: 100%; width: 62%; pointer-events: none; }
  .fech__in { position: relative; }
  .fech .cabeca { max-width: 600px; }
  @media (max-width: 860px) {
    .fech__faixas { width: 110%; right: -55%; opacity: .45; }
  }
</style>
