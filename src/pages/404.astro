---
import Base from "../layouts/Base.astro";
import Seta from "../components/Seta.astro";
---
<Base titulo="Página não encontrada">
  <section class="secao bg-claro">
    <div class="wrap stack" style="max-width:640px">
      <p class="rotulo">404</p>
      <h1>Esta página não existe.</h1>
      <p class="lead">O endereço pode ter mudado. Volte ao início ou fale com a gente.</p>
      <div class="acoes"><a class="btn" href="/">Ir para o início <Seta /></a><a class="btn btn--ghost" href="/contato">Contato</a></div>
    </div>
  </section>
</Base>
