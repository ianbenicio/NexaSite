---
import Base from "../layouts/Base.astro";
import Seta from "../components/Seta.astro";
import Icone from "../components/Icone.astro";
import FotoFaixa from "../components/FotoFaixa.astro";
import Fechamento from "../components/Fechamento.astro";
import { DADOS, EVIDENCIAS, FALAS, ETAPAS_CURTAS, CNE } from "../data/site";
// Cenas da home: situações descritivas, sem caso real nem número inventado (D-007).
// Gramática neutra: a home é lida por escolas, então nada de vocabulário vetado no B2B (D-010).
const cenas = [
  {
    quem: "Escolas e redes",
    titulo: "Cada professor usa a IA de um jeito, e ninguém combinou nada.",
    texto: "Uma professora prepara aulas com um assistente de IA. O colega da sala ao lado proibiu. A coordenação descobre pelos alunos. Quando a família pergunta, cada um responde uma coisa.",
    nexa: "Escutamos quem já usa e escrevemos com a equipe uma política com usos permitidos por etapa. A instituição passa a dar uma resposta só.",
  },
  {
    quem: "Rede pública",
    titulo: "O prazo das diretrizes começou a correr, e a rede não sabe por onde começar.",
    texto: "A orientação chegou, o controle externo vai perguntar, e a equipe técnica já está no limite com o resto da agenda. Doze meses parecem muito até virarem seis.",
    nexa: "Traduzimos as diretrizes para a realidade da rede e entregamos a diretriz municipal com um plano de adequação, responsáveis e marcos.",
  },
  {
    quem: "Escola particular",
    titulo: "Uma mãe perguntou na reunião se a escola usa IA. A resposta foi um silêncio.",
    texto: "As famílias leem sobre IA todos os dias e querem saber o que acontece com os filhos. Sem uma posição clara, cada conversa vira improviso, e isso aparece na matrícula.",
    nexa: "Construímos a política de IA da escola e uma versão em linguagem de família, com roteiro para a equipe usar nas conversas de matrícula.",
  },
  {
    quem: "Escola particular",
    titulo: "A escola paga por várias ferramentas, e a equipe usa poucas.",
    texto: "Uma assinatura veio com a plataforma, outra foi contratada por um setor, uma terceira ficou de um teste. Algumas fazem a mesma coisa, outras ninguém abre. A fatura chega todo mês, e ninguém sabe dizer quanto disso volta em tempo para o professor.",
    nexa: "Mapeamos o que é contratado e o que é usado de fato, cortamos sobreposições e reorganizamos o processo em torno das ferramentas que ficam. A escola passa a pagar só pelo que a equipe usa.",
  },
];
---
<Base>
  <!-- 1 · Topo (Guia 4.1 · Site e redes) -->
  <section class="hero bg-claro">
    <div class="wrap hero__in">
      <div class="hero__txt">
        <p class="rotulo">Processos, pessoas e IA na educação</p>
        <h1>Organize o processo antes da escolha da ferramenta.</h1>
        <p class="lead">Ajudamos redes públicas e escolas particulares a trabalharem com tecnologias e IA, com eficiência e responsabilidade.</p>
        <div class="acoes">
          <a class="btn" href="/contato">Solicitar conversa <Seta /></a>
          <a class="btn btn--ghost" href="/metodo">Ver o método</a>
        </div>
        <p class="legenda hero__nota">Conversa inicial de 40 minutos, sem custo.</p>
      </div>
      <FotoFaixa />
    </div>
  </section>


  <!-- 2 · Dois caminhos (D-005: nenhum material atravessa a fronteira sem tradução) -->
  <section class="secao bg-branco" aria-labelledby="caminhos-t">
    <div class="wrap">
      <div class="cabeca">
        <p class="rotulo">Para quem trabalhamos</p>
        <h2 id="caminhos-t">Dois públicos, a mesma ordem de trabalho.</h2>
      </div>
      <div class="grid-2 caminhos">
        <a class="caminho caminho--rede" href="/redes-escolares/rede-publica">
          <Icone nome="governanca" />
          <p class="rotulo">Redes públicas</p>
          <h3>Secretarias municipais de educação</h3>
          <p>{FALAS.b2g}</p>
          <span class="link-seta">Diretriz, plano de adequação e formação <Seta /></span>
        </a>
        <a class="caminho caminho--escola" href="/redes-escolares/escolas-particulares">
          <Icone nome="pessoas" />
          <p class="rotulo">Escolas particulares</p>
          <h3>Direção, mantenedores e coordenação</h3>
          <p>{FALAS.b2b}</p>
          <span class="link-seta">Política, versão para famílias e processos <Seta /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3 · Cenas: o visitante se reconhece antes de ler sobre a Nexa -->
  <section class="secao bg-claro" aria-labelledby="cenas-t">
    <div class="wrap">
      <div class="cabeca">
        <p class="rotulo">Talvez seja o seu caso</p>
        <h2 id="cenas-t">Alguma destas cenas parece com a sua semana?</h2>
        <p class="lead">São cenas comuns em escolas. Nenhuma se resolve com uma ferramenta nova. Todas começam a mudar quando alguém organiza o processo.</p>
      </div>
      <ul class="cenas">
        {cenas.map((c) => (
          <li class="cena">
            <p class="cena__quem">{c.quem}</p>
            <h3>{c.titulo}</h3>
            <p class="cena__texto">{c.texto}</p>
            <div class="cena__nexa">
              <p class="rotulo">Com a Nexa</p>
              <p>{c.nexa}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="cenas__fim">
        <p>Se reconheceu alguma, a conversa começa por ela.</p>
        <a class="btn" href="/contato">Solicitar conversa <Seta /></a>
      </div>
    </div>
  </section>

  <!-- 4 · Por que agora (Doutrina 5.2) -->
  <section class="secao bg-noite on-dark agora" aria-labelledby="agora-t">
    <div class="wrap">
      <div class="agora__topo">
        <div class="cabeca">
          <p class="rotulo">Por que agora</p>
          <h2 id="agora-t">A tecnologia de IA já chegou à escola, e para ficar.</h2>
          <p class="lead">{CNE.frase}</p>
        </div>
        <div class="prazo" aria-label="12 meses de adequação">
          <Seta modo="cor" class="prazo__seta" />
          <p><span class="prazo__n tabular">12</span><span class="prazo__u">meses</span></p>
          <Seta modo="cor" class="prazo__seta prazo__seta--inv" />
        </div>
      </div>
      <ul class="dados">
        {DADOS.map((d) => (
          <li>
            <p class="dados__v tabular">{d.valor}</p>
            <p>{d.texto}</p>
            <p class="legenda">Fonte: <a href={d.url} target="_blank" rel="noopener">{d.fonte}<span class="sr-only"> (abre em nova aba)</span></a></p>
          </li>
        ))}
      </ul>

      <div class="indaga">
        <div class="indaga__txt">
          <p class="rotulo">A pergunta que fica</p>
          <p class="indaga__tit">Os números mostram quantos usam. Eles mostram se usam bem?</p>
          <p>A adesão cresceu mais rápido do que qualquer formação, regra ou acompanhamento conseguiu acompanhar. A IA está nos celulares, nos planejamentos e nas secretarias. Se ela está melhorando o ensino e a rotina da escola, ou só acontecendo, ninguém consegue dizer ainda. A própria OCDE registra que o impacto da IA na educação segue incerto.</p>
        </div>
        <ul class="indaga__lista">
          {EVIDENCIAS.map((d) => (
            <li>
              <p class:list={["indaga__v tabular", { "indaga__v--longo": d.valor.length > 8 }]}>{d.valor}</p>
              <p>{d.texto}</p>
              <p class="legenda">Fonte: <a href={d.url} target="_blank" rel="noopener">{d.fonte}<span class="sr-only"> (abre em nova aba)</span></a></p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5 · Como trabalhamos (trilho de setas) -->
  <section class="secao bg-branco" aria-labelledby="como-t">
    <div class="wrap">
      <div class="cabeca">
        <p class="rotulo">Como trabalhamos</p>
        <h2 id="como-t">Quatro etapas, nesta ordem.</h2>
        <p class="lead">A ferramenta vem por último. Às vezes a resposta certa é “ainda não”.</p>
      </div>
      <ol class="trilho">
        {ETAPAS_CURTAS.map((e, i) => (
          <li class={i === 0 ? "atual" : ""}>
            <div class="trilho__marca">
              <Seta modo={i === 0 ? "cor" : i === 1 ? "uma" : "contorno"} class={`trilho__seta t${i}`} />
              <span class="trilho__n tabular">0{i + 1}</span>
            </div>
            <h3 class="trilho__tit"><Icone nome={e.icone} class="trilho__ic" />{e.nome}</h3>
            <p>{e.texto}</p>
          </li>
        ))}
      </ol>
      <div class="recusa">
        <p class="rotulo">O que você não vai receber de nós</p>
        <p>Plataforma pronta procurando onde encaixar, curso solto sem acompanhamento, ferramenta indicada por comissão ou um “sim” para tudo. Quando algo não deve ser feito, dizemos, mesmo que isso reduza o nosso contrato.</p>
      </div>
      <a class="link-seta" href="/metodo">Ver o Ciclo Nexa completo <Seta /></a>
    </div>
  </section>

  <!-- 6 · Conteúdos (workshops, D-052) -->
  <section class="secao--tight bg-menta-papel" aria-labelledby="ws-t">
    <div class="wrap ws">
      <Icone nome="formacao" />
      <div>
        <p class="rotulo">Conteúdos · Workshops</p>
        <h2 id="ws-t">Duas a três horas para tirar dúvidas, enxergar possibilidades e identificar onde a IA pede atenção na sua instituição.</h2>
      </div>
      <a class="btn btn--ghost" href="/conteudos">Ver conteúdos</a>
    </div>
  </section>

  <Fechamento
    titulo="Comece por uma conversa de 40 minutos, sem custo."
    texto="Entendemos o pedido nas suas palavras. Se fizer sentido seguir, o escopo sai por escrito. Se a resposta certa for “ainda não”, dizemos."
  />
</Base>

<style>
  .hero { padding-block: clamp(48px, 7vw, 104px) clamp(56px, 8vw, 112px); overflow: hidden; }
  .hero__in { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero__txt > * + * { margin-top: 24px; }
  .hero__txt .acoes { margin-top: 40px; }
  @media (max-width: 900px) { .hero__in { grid-template-columns: 1fr; } }

  .agora__topo { display: flex; justify-content: space-between; gap: 48px; align-items: center; flex-wrap: wrap; }
  .prazo { display: flex; align-items: center; gap: 12px; }
  .prazo p { display: flex; flex-direction: column; align-items: center; line-height: 1; }
  .prazo__n { font-family: var(--font-titulo); font-weight: 600; font-size: clamp(72px, 9vw, 112px); letter-spacing: -0.03em; }
  .prazo__u { font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: 14px; color: var(--nexa-menta); margin-top: 8px; }
  .prazo :global(.prazo__seta) { width: clamp(40px, 4.5vw, 56px); }
  .prazo :global(.prazo__seta--inv) { transform: rotate(180deg); }
  .dados { list-style: none; padding: 0; margin: 64px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .dados li { border-top: 1px solid rgb(204 213 229 / .25); padding-top: 24px; }
  .dados li > * + * { margin-top: 8px; }
  .indaga { margin-top: 72px; padding-top: 56px; border-top: 1px solid rgb(204 213 229 / .25); display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
  @media (max-width: 900px) { .indaga { grid-template-columns: 1fr; } }
  .indaga__txt > * + * { margin-top: 16px; }
  .indaga__txt p:last-child { color: var(--nexa-claro-noite); }
  .indaga__tit { font-family: var(--font-titulo); font-weight: 600; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.2; color: var(--nexa-branco); }
  .indaga__lista { list-style: none; padding: 0; margin: 0; display: grid; }
  .indaga__lista li { display: grid; grid-template-columns: 8.5em 1fr; column-gap: 20px; padding: 20px 0; border-top: 1px solid rgb(204 213 229 / .25); }
  .indaga__lista li:first-child { border-top: 0; padding-top: 0; }
  .indaga__lista .legenda { grid-column: 2; margin-top: 6px; }
  .indaga__v { grid-row: span 2; font-family: var(--font-titulo); font-weight: 600; font-size: clamp(26px, 2.6vw, 32px); line-height: 1.1; color: var(--nexa-claro); }
  .indaga__v--longo { font-size: clamp(20px, 1.9vw, 24px); }
  @media (max-width: 520px) { .indaga__lista li { grid-template-columns: 1fr; } .indaga__lista .legenda { grid-column: 1; } .indaga__v { grid-row: auto; margin-bottom: 6px; } }
  .dados__v { font-family: var(--font-titulo); font-weight: 600; font-size: clamp(44px, 5vw, 64px); line-height: 1; color: var(--nexa-menta); letter-spacing: -0.02em; }
  @media (max-width: 720px) { .dados { grid-template-columns: 1fr; gap: 0; } .dados li { padding-block: 24px; } }

  .caminhos { margin-top: 48px; }
  .hero__nota { margin-top: 16px !important; }
  .caminho {
    display: flex; flex-direction: column; gap: 16px; text-decoration: none; color: inherit;
    padding: clamp(28px, 3.5vw, 48px); border-radius: var(--raio); border: 1px solid var(--nexa-linha);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .caminho:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgb(17 26 51 / .08); border-color: var(--nexa-violeta); }
  .caminho--rede { background: var(--nexa-branco); }
  .caminho--escola { background: var(--nexa-menta-papel); border-color: var(--nexa-menta-suave); }
  .caminho .link-seta { margin-top: auto; padding-top: 8px; }

  .trilho { list-style: none; padding: 0; margin: 56px 0 40px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; position: relative; }
  .trilho::before { content: ""; position: absolute; left: 0; right: 0; top: 28px; height: 1px; background: var(--nexa-linha); }
  .trilho li { position: relative; }
  .trilho li > * + * { margin-top: 12px; }
  .trilho__marca { display: flex; align-items: center; gap: 12px; background: var(--nexa-branco); width: max-content; padding-right: 12px; }
  .trilho :global(.trilho__seta) { width: 44px; }
  .trilho :global(.t1) { color: var(--nexa-menta); }
  .trilho :global(.t2), .trilho :global(.t3) { color: var(--nexa-muted); }
  .trilho__n { font-weight: 700; color: var(--nexa-muted); font-size: 14px; letter-spacing: .1em; }
  .trilho p { color: var(--nexa-muted); }
  @media (max-width: 900px) { .trilho { grid-template-columns: 1fr 1fr; } .trilho::before { display: none; } }
  @media (max-width: 520px) { .trilho { grid-template-columns: 1fr; } }

  .recusa { margin: 8px 0 40px; padding: 24px 28px; border-left: 3px solid var(--nexa-violeta); background: var(--nexa-claro); border-radius: 0 var(--raio-sm) var(--raio-sm) 0; max-width: 860px; }
  .recusa > * + * { margin-top: 8px; }

  .cenas { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 24px; }
  .cena { display: flex; flex-direction: column; gap: 14px; padding: clamp(24px, 3vw, 36px); border: 1px solid var(--nexa-linha); border-radius: var(--raio); background: var(--nexa-branco); }
  .cena__quem { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--nexa-muted); }
  .cena h3 { font-size: clamp(19px, 1.7vw, 21px); }
  .cena__texto { color: var(--nexa-muted); }
  .cena__nexa { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--nexa-linha); }
  .cena__nexa > * + * { margin-top: 8px; }
  .cenas__fim { margin-top: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding: 28px 32px; border-radius: var(--raio); background: var(--nexa-noite); color: var(--nexa-claro); }
  .cenas__fim p { font-family: var(--font-titulo); font-weight: 600; font-size: clamp(19px, 2vw, 24px); }

  .ws { display: flex; align-items: center; gap: 32px; }
  .ws > div { flex: 1; }
  .ws h2 { font-size: clamp(21px, 2.2vw, 26px); margin-top: 8px; max-width: 32ch; }
  .ws :global(.icone) { width: 48px; height: 48px; }
  @media (max-width: 720px) { .ws { flex-direction: column; align-items: flex-start; gap: 16px; } }
  .trilho__tit { display: flex; align-items: center; gap: 12px; }
  .trilho__ic { width: 28px; height: 28px; color: var(--nexa-violeta); }
</style>
